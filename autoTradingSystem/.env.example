# Trading System Configuration Template
# Copy this file to .env and fill in your actual API keys

# ============================================
# Cryptocurrency Exchange APIs
# ============================================

# Binance (Global)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Upbit (Korea)
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# ============================================
# Stock Trading APIs
# ============================================

# Alpaca (US Stocks) - Paper Trading
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 한국투자증권 (Korea Investment & Securities)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=your_account_number_here

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///trading_system.db
# For PostgreSQL: postgresql://user:password@localhost:5432/trading_db

# ============================================
# Trading Configuration
# ============================================
TRADING_MODE=paper  # paper or live
MAX_POSITION_SIZE=0.1  # Maximum position size (10% of portfolio)
STOP_LOSS_PERCENTAGE=0.05  # 5% stop loss
TAKE_PROFIT_PERCENTAGE=0.10  # 10% take profit
MAX_DAILY_LOSS=0.03  # 3% maximum daily loss

# ============================================
# Notification Settings
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notifications
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/trading_system.log
