# Trading System Configuration Template
# 이 파일을 .env로 복사하고 API 키를 입력하세요.
# 
# 설정 방식:
# - trading_config.py에 기본값이 정의되어 있습니다
# - .env 파일의 설정은 기본값을 오버라이드합니다
# - 필요한 항목만 설정하면 됩니다 (주석 해제)
# - 설정하지 않은 항목은 기본값이 사용됩니다

# ============================================
# 거래소 선택 (Exchange Selection)
# ============================================
# EXCHANGE_NAME 을 변경하여 사용할 거래소를 선택하세요.
#   upbit   → Upbit (KRW 마켓, testnet 미지원)
#   binance → Binance (USDT 마켓, testnet 지원) ← 백업/기본값
#
EXCHANGE_NAME=upbit
# EXCHANGE_NAME=binance

# Testnet 모드 (Binance 전용, Upbit은 무시됨)
EXCHANGE_TESTNET=true

# ============================================
# Cryptocurrency Exchange API Keys
# ============================================

# --- Upbit (현재 사용 중) ---
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# --- Binance (백업용) ---
# BINANCE_API_KEY=your_binance_api_key_here
# BINANCE_SECRET_KEY=your_binance_secret_key_here

# ============================================
# Stock Trading APIs (선택, 미구현)
# ============================================
# ALPACA_API_KEY=your_alpaca_api_key_here
# ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# KIS_APP_KEY=your_kis_app_key_here
# KIS_APP_SECRET=your_kis_app_secret_here
# KIS_ACCOUNT_NO=your_account_number_here

# ============================================
# Database Configuration (선택, 미구현)
# ============================================
# DATABASE_URL=sqlite:///trading_system.db

# ============================================
# Trading Configuration (선택)
# ============================================
# Upbit 사용 시: 심볼을 KRW 마켓으로 변경 (예: XRP/KRW, BTC/KRW)
# Binance 사용 시: USDT 마켓 사용 (예: XRP/USDT, BTC/USDT)
# TRADING_SYMBOL=XRP/KRW
# TRADING_TIMEFRAME=15m
# UPDATE_INTERVAL=60
# INITIAL_BALANCE=10000
# DRY_RUN=true

# ============================================
# Strategy Configuration (선택)
# ============================================
# STRATEGY_NAME=RSIOBVStrategy  # RSIStrategy, MACDStrategy, MovingAverageCrossStrategy, OBVStrategy, RSIOBVStrategy

# RSI Strategy
# RSI_OVERSOLD=30
# RSI_OVERBOUGHT=70
# RSI_PERIOD=14

# MACD Strategy
# MACD_FAST_PERIOD=12
# MACD_SLOW_PERIOD=26
# MACD_SIGNAL_PERIOD=9

# MA Cross Strategy
# MA_FAST_PERIOD=20
# MA_SLOW_PERIOD=50

# OBV Strategy
# OBV_MA_PERIOD=20
# OBV_DIVERGENCE_LOOKBACK=5

# RSI + OBV Strategy
# OBV_WEIGHT=0.5

# ============================================
# Risk Management Configuration (선택)
# ============================================
# MAX_POSITION_SIZE=0.1
# STOP_LOSS_PERCENTAGE=0.05
# TAKE_PROFIT_PERCENTAGE=0.10
# MAX_DAILY_LOSS=0.03
# MAX_POSITIONS=3
# RISK_REWARD_RATIO=2.0
# TRAILING_STOP_PCT=0.03

# ============================================
# Notification Settings (선택)
# ============================================
# NOTIFICATION_ENABLED=false

# Telegram
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email
# EMAIL_ENABLED=false
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_ADDRESS=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password_here

# ============================================
# Logging (선택)
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/trading_bot.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ============================================
# Advanced Configuration (선택)
# ============================================
# ENABLE_TRAILING_STOP=true
# ENABLE_PARTIAL_TAKE_PROFIT=false
# PARTIAL_TAKE_PROFIT_PCT=0.5
# MIN_ORDER_SIZE=0.001
